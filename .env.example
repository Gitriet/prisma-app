# ── Database (Neon) ───────────────────────────────────────────
# Get these from your Neon project dashboard → Connection Details
# Use the "Pooled connection" string for DATABASE_URL
# Use the "Direct connection" string for DIRECT_URL (needed for migrations)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# The public URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ── Email (magic link) ────────────────────────────────────────
# Any SMTP provider works: Resend, Postmark, SendGrid, Brevo, etc.
# Example using Resend SMTP:
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_your_api_key"
EMAIL_FROM="Prisma <noreply@yourdomain.com>"

# ── Admin ─────────────────────────────────────────────────────
# After first login, set isAdmin=true for your user directly in the DB:
# UPDATE "User" SET "isAdmin" = true WHERE email = 'you@example.com';
